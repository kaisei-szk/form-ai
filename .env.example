# Search and classification
SERPER_API_KEY=your_serper_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# n8n
N8N_API_KEY=your_n8n_api_key_here
N8N_WORKFLOW_ID=your_n8n_workflow_id_here
# Docker Compose uses http://web:3000 by default. When n8n runs in Docker and
# Next.js runs directly on the host, uncomment the following line.
# WEB_CALLBACK_URL=http://host.docker.internal:3000

# Google Sheets export
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_SHEETS_SHEET_NAME=企業リスト
SHEETS_OWNER_EMAIL=your_email@example.com

# Runtime tuning
MAX_CONCURRENT_RUNS=3
REQUEST_DELAY_MS=1100
BATCH_SIZE=5
# Serper Places is stopped after two consecutive repeated/empty pages.
# This value is only a safety ceiling; lowering it can reduce coverage.
SERPER_MAX_PAGES=50
SERPER_ORGANIC_MAX_PAGES=20
# Maximum number of independent organic query variants across all keywords.
SERPER_ORGANIC_QUERY_LIMIT=30
# Stop starting new Serper batches before the hosting 300-second hard limit.
# Self-hosted (n8n/local) runs can raise this up to 1800000 (30 min).
SERPER_TIME_BUDGET_MS=240000
# Separate time budget for portal discovery (candidate expansion). 0 disables it.
SERPER_PORTAL_TIME_BUDGET_MS=180000
SERPER_CONCURRENCY=5

# Optional form sender identity
SENDER_NAME=
SENDER_EMAIL=
SENDER_COMPANY=
