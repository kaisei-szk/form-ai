# Search and classification
SERPER_API_KEY=your_serper_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Supabase
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# n8n
N8N_API_KEY=your_n8n_api_key_here
N8N_WORKFLOW_ID=your_n8n_workflow_id_here
# Docker Compose uses http://web:3000 by default. When n8n runs in Docker and
# Next.js runs directly on the host, uncomment the following line.
# WEB_CALLBACK_URL=http://host.docker.internal:3000

# Google Sheets export
GOOGLE_SHEETS_ID=your_google_sheets_id_here
GOOGLE_SHEETS_SHEET_NAME=企業リスト
SHEETS_OWNER_EMAIL=your_email@example.com

# Runtime tuning
MAX_CONCURRENT_RUNS=3
REQUEST_DELAY_MS=1100
BATCH_SIZE=5
# Serper Places is stopped after two consecutive repeated/empty pages.
# This value is only a safety ceiling; lowering it can reduce coverage.
SERPER_MAX_PAGES=50
SERPER_PLACES_QUERY_LIMIT=12
SERPER_AREA_PARTITION_LIMIT=18
SERPER_PARTITION_KEYWORD_LIMIT=3
SERPER_PLACES_TOTAL_QUERY_LIMIT=72
SERPER_ORGANIC_MAX_PAGES=20
# Maximum number of independent organic query variants across all keywords.
SERPER_ORGANIC_QUERY_LIMIT=60
# Main Places/organic search budget: 32 minutes.
# Keep the outer API/n8n timeout above the combined search phases.
SERPER_TIME_BUDGET_MS=2700000
# Separate time budget for portal discovery (candidate expansion). 0 disables it.
SERPER_PORTAL_TIME_BUDGET_MS=1800000
SERPER_CONCURRENCY=5
# Hot Pepper対象業種では、市区町村別一覧を全ページ列挙して店舗詳細を補完する。
HOTPEPPER_MAX_PAGES=150
HOTPEPPER_DETAIL_LIMIT=2000
HOTPEPPER_FETCH_CONCURRENCY=4
HOTPEPPER_REQUEST_DELAY_MS=250
SERPER_PORTAL_LISTING_LIMIT=30
SERPER_PORTAL_DETAIL_LIMIT=500
SERPER_PORTAL_RESEARCH_LIMIT=3000
SERPER_PORTAL_RESEARCH_CONCURRENCY=10
SERPER_PRIOR_UNRESOLVED_LIMIT=2500
SERPER_RESOLUTION_MAX_ATTEMPTS=5
SERPER_HOLD_RETRY_LIMIT=1000

# Optional form sender identity
SENDER_NAME=
SENDER_EMAIL=
SENDER_COMPANY=
# Per-candidate CPU watchdog for synchronous page text analysis (milliseconds).
SCRAPE_ITEM_CPU_LIMIT_MS=500
# Maximum characters passed to the CPU-bounded free-text scanner.
SCRAPE_ITEM_TEXT_LIMIT_CHARS=250000
