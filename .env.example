# ======================================
# リスト収集AI - 環境変数設定
# ======================================
# このファイルを .env にコピーして各値を設定してください
# cp .env.example .env

# --- Google Custom Search API ---
# https://developers.google.com/custom-search/v1/introduction
GOOGLE_SEARCH_API_KEY=your_google_api_key_here
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id_here

# --- Google Maps Places API ---
# 同じAPIキーで利用可能（Places APIを有効化すること）
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# --- OpenAI API (フォーム種別判定) ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- Google Sheets ---
# スプレッドシートIDは自動作成時に自動入力されます（空欄でOK）
# 既存のスプシを使う場合はURLの /d/{ID}/ 部分を入力
GOOGLE_SHEETS_ID=
GOOGLE_SHEETS_SHEET_NAME=企業リスト

# スプレッドシートを共有するGmailアドレス（自動作成時に自動共有されます）
SHEETS_OWNER_EMAIL=your_email@gmail.com

# --- Google Service Account (Sheets API認証) ---
# サービスアカウントJSONファイルのパス
GOOGLE_SERVICE_ACCOUNT_PATH=./config/service-account.json

# --- Supabase (Project Settings → Data API → Project URL / service_role key) ---
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_KEY=your_supabase_service_role_key_here

# --- Serper.dev (企業検索用API) ---
SERPER_API_KEY=your_serper_api_key_here

# --- n8n連携 ---
N8N_API_KEY=your_n8n_api_key_here
N8N_WORKFLOW_ID=your_n8n_workflow_id_here

# --- 本番デプロイ時のみ使用（docker-compose.prod.yml / VPS上のn8n用）---
# n8nを外部公開するVPSのIPまたはドメイン
N8N_HOST=your-vps-ip-or-domain
N8N_PROTOCOL=http
WEBHOOK_URL=http://your-vps-ip-or-domain:5678/
# Web本体（Vercel）のデプロイ先URL。n8nがワーク完了をここに通知する
WEB_CALLBACK_URL=https://your-app.vercel.app
INTERNAL_API_SECRET=replace-with-a-long-random-secret
APP_BASIC_AUTH_USER=admin
APP_BASIC_AUTH_PASSWORD=replace-with-a-long-random-password

# --- 実行設定 ---
# 1バッチあたりの処理件数（レート制限対策）
BATCH_SIZE=5
# リクエスト間隔 (ミリ秒)
REQUEST_DELAY_MS=2000
# HTTPタイムアウト (ミリ秒)
HTTP_TIMEOUT_MS=10000
# リトライ回数
MAX_RETRIES=3

# --- ログ設定 ---
LOG_LEVEL=info
LOG_FILE=./logs/collector.log
